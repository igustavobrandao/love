# Postgres do Neon (Connection string, com ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# Senha do dashboard
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Segredo para assinar a sessão (mínimo 32 caracteres): openssl rand -base64 48
SESSION_SECRET=
# Criado automaticamente ao conectar um Vercel Blob store ao projeto
BLOB_READ_WRITE_TOKEN=
